<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Registration Form</title>
     <link rel="stylesheet" href="/static/addstudent.css">
</head>
<body>
    <div class="container">
        <h1>Student Registration Form</h1>
        
        <form action="/submit" method="POST">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required>
            </div>
            
            <div class="form-group">
                <label for="hostel">Hostel</label>
                <input type="text" id="hostel" name="hostel" required>
            </div>
            
            <div class="form-group">
                <label for="course_id">Course ID</label>
                <input type="text" id="course_id" name="course_id" required>
            </div>
            
            <div class="form-group">
                <label for="enroll_no">Enrollment Number</label>
                <input type="text" id="enroll_no" name="enroll_no" required>
            </div>
            
            <div class="form-group">
                <label for="registered_session">Registered Session</label>
                <input type="text" id="registered_session" name="registered_session" required placeholder="e.g., 2023-2024">
            </div>
            
            <div class="form-group">
                <label for="mess_slip">Mess Slip Number</label>
                <input type="text" id="mess_slip" name="mess_slip" required>
            </div>
            
            <button type="submit" class="btn">Submit Registration</button>
        </form>
        
        <div class="footer-text">
            All fields are required. Please ensure information is accurate.
        </div>
    </div>
</body>
</html>

